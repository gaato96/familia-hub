# ---------------------------------------------------------------------------
# Supabase — proyecto DEDICADO a Family Hub (no compartir con otros proyectos)
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. SOLO server-side. Nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña de la base, para `npm run db:push` (Settings → Database).
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Web Push (VAPID) — generar con `npm run push:keys`
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aplicaciones@leadadgo.com

# ---------------------------------------------------------------------------
# Cron de Vercel — protege /api/cron/*. Cualquier string largo y aleatorio.
# ---------------------------------------------------------------------------
CRON_SECRET=

# URL pública del deploy, para los links dentro de las notificaciones push.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
